%% ER Diagram ของ CourseHub ตาม Flyway V1 schema และ V3/V4 ALTER TABLE
%% PK = Primary Key, FK = Foreign Key, UK = Unique Key
%% สร้างภาพ: npx -p @mermaid-js/mermaid-cli mmdc -i er-diagram.mmd -c er-diagram.config.json -o er-diagram.png -b white -s 1.8
erDiagram
    users {
        BIGINT id PK
        VARCHAR(255) email UK
        VARCHAR(255) password_hash
        VARCHAR(20) role "LEARNER | ADMIN"
        VARCHAR(20) status "ACTIVE | SUSPENDED"
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    user_profiles {
        BIGINT user_id PK, FK "shared PK กับ users.id"
        VARCHAR(100) display_name
        VARCHAR(1000) bio
        VARCHAR(255) avatar_path
    }

    providers {
        BIGINT id PK
        VARCHAR(100) name
        VARCHAR(100) slug UK
        TEXT description
        VARCHAR(255) website_url
        VARCHAR(20) status "PENDING | ACTIVE | SUSPENDED"
        INTEGER version "optimistic lock"
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    provider_members {
        BIGINT id PK
        BIGINT provider_id FK "UK(provider_id, user_id)"
        BIGINT user_id FK "UK(provider_id, user_id)"
        VARCHAR(20) member_role "OWNER | EDITOR"
    }

    platforms {
        BIGINT id PK
        VARCHAR(100) name
        VARCHAR(100) slug UK
        VARCHAR(255) allowed_host UK
    }

    courses {
        BIGINT id PK
        BIGINT provider_id FK "ON DELETE RESTRICT"
        BIGINT platform_id FK "ON DELETE RESTRICT"
        VARCHAR(200) title
        VARCHAR(100) slug UK
        TEXT description
        VARCHAR(2048) url
        VARCHAR(20) level "BEGINNER | INTERMEDIATE | ADVANCED"
        VARCHAR(20) language "THAI | ENGLISH | SUB_THAI"
        INTEGER effort_hours "NULL หรือ > 0"
        VARCHAR(30) status "DRAFT | PENDING | PUBLISHED | REVISION_REQUESTED | SUSPENDED | ARCHIVED"
        INTEGER version "optimistic lock"
        VARCHAR(1000) moderation_reason "V3"
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    course_prices {
        BIGINT course_id PK, FK "shared PK กับ courses.id"
        VARCHAR(20) payment_type "FREE | ONE_TIME | SUBSCRIPTION"
        DECIMAL amount "(10,2) NULL = ไม่ทราบราคา, >= 0"
        VARCHAR(10) currency
        TIMESTAMPTZ checked_at
    }

    categories {
        BIGINT id PK
        VARCHAR(100) name
        VARCHAR(100) slug UK
    }

    course_categories {
        BIGINT course_id PK, FK
        BIGINT category_id PK, FK
    }

    reviews {
        BIGINT id PK
        BIGINT course_id FK "UK(course_id, user_id)"
        BIGINT user_id FK "UK(course_id, user_id)"
        INTEGER overall_score "1-5"
        INTEGER content_score "1-5"
        INTEGER teaching_score "1-5"
        INTEGER difficulty_score "1-5"
        TEXT body
        VARCHAR(20) status "PENDING | PUBLISHED | REJECTED"
        INTEGER version "V4 optimistic lock"
        VARCHAR(1000) moderation_reason "V4"
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    saved_courses {
        BIGINT user_id PK, FK
        BIGINT course_id PK, FK
        TIMESTAMPTZ created_at
    }

    audit_logs {
        BIGINT id PK
        BIGINT actor_user_id FK "ON DELETE RESTRICT"
        VARCHAR(50) action
        VARCHAR(30) entity_type
        BIGINT entity_id
        VARCHAR(30) old_status
        VARCHAR(30) new_status
        VARCHAR(1000) reason "V3"
        TIMESTAMPTZ created_at
    }

    users ||--o| user_profiles : "has (0..1 profile)"
    users ||--o{ provider_members : "joins"
    providers ||--o{ provider_members : "includes"
    providers ||--o{ courses : "offers"
    platforms ||--o{ courses : "hosts"
    courses ||--o| course_prices : "current price (1:1)"
    courses ||--o{ course_categories : "classified by"
    categories ||--o{ course_categories : "contains"
    users ||--o{ reviews : "writes"
    courses ||--o{ reviews : "receives"
    users ||--o{ saved_courses : "saves"
    courses ||--o{ saved_courses : "bookmarked in"
    users ||--o{ audit_logs : "acts"
